<Window x:Class="CRM.Frontend.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CRM AQL — Connexion"
        Height="520" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource PrimaryBrush}"
        FontFamily="{StaticResource PrimaryFont}">

  <Grid VerticalAlignment="Center" Margin="40">
    <StackPanel>

      <!-- Logo / Titre -->
      <TextBlock Text="🏭" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,8"/>
      <TextBlock Text="CRM AQL 420-454-RI"
                 FontSize="22" FontWeight="Bold"
                 Foreground="{StaticResource TextBrush}"
                 HorizontalAlignment="Center"/>
      <TextBlock Text="Système Manufacturing Just In Time"
                 FontSize="12"
                 Foreground="{StaticResource SubtextBrush}"
                 HorizontalAlignment="Center"
                 Margin="0,4,0,32"/>

      <!-- Card -->
      <Border Style="{StaticResource Card}">
        <StackPanel>

          <!-- Login -->
          <TextBlock Text="Identifiant" FontSize="12" FontWeight="SemiBold"
                     Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtLogin"
                   Style="{StaticResource InputBox}"
                   Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                   Margin="0,0,0,16"/>

          <!-- Mot de passe -->
          <TextBlock Text="Mot de passe" FontSize="12" FontWeight="SemiBold"
                     Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,4"/>
          <Grid Margin="0,0,0,20">
            <PasswordBox x:Name="PwdBox"
                         Style="{StaticResource InputPassword}"
                         PasswordChanged="OnPasswordChanged"/>
            <TextBox x:Name="TxtPwdVisible"
                     Style="{StaticResource InputBox}"
                     Visibility="Collapsed"
                     TextChanged="OnPwdVisibleChanged"/>
            <Button Content="👁️"
                    Background="Transparent" BorderThickness="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Height="24" Width="30" Margin="0,0,4,0"
                    Click="OnTogglePassword" Focusable="False"/>
          </Grid>

          <!-- Message d'erreur -->
          <Border x:Name="ErrorBorder"
                  Background="#3E1E1E" CornerRadius="6" Padding="12,8"
                  Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}"
                  Margin="0,0,0,16">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="13" TextWrapping="Wrap"/>
          </Border>

          <!-- Bouton -->
          <Button Content="Se connecter"
                  Style="{StaticResource BaseButton}"
                  Command="{Binding LoginCommand}"
                  CommandParameter="{Binding ElementName=PwdBox}"
                  IsDefault="True"/>

        </StackPanel>
      </Border>

      <!-- Footer -->
      <TextBlock Text="© 2026 Projet AQL 420-454-RI"
                 FontSize="11" Foreground="{StaticResource SubtextBrush}"
                 HorizontalAlignment="Center" Margin="0,20,0,0"/>

    </StackPanel>
  </Grid>


</Window>
