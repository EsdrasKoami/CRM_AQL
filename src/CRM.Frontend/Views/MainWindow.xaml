<Window x:Class="CRM.Frontend.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CRM AQL 420-454-RI"
        Height="700" Width="1150"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PrimaryBrush}"
        FontFamily="{StaticResource PrimaryFont}">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>   <!-- Sidebar -->
      <ColumnDefinition Width="*"/>     <!-- Content -->
    </Grid.ColumnDefinitions>

    <!-- ── Sidebar ────────────────────────────────────────────────────── -->
    <Border Grid.Column="0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="20,24,20,32">
          <TextBlock Text="🏭 CRM AQL" FontSize="18" FontWeight="Bold"
                     Foreground="{StaticResource TextBrush}"/>
          <TextBlock Text="{Binding UserDisplay}"
                     FontSize="12" Foreground="{StaticResource SubtextBrush}"
                     Margin="0,4,0,0"/>
          <Border Background="#2E3650" CornerRadius="4" Padding="6,2"
                  HorizontalAlignment="Left" Margin="0,6,0,0">
            <TextBlock Text="{Binding RoleBadge}" FontSize="11"
                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
          </Border>
        </StackPanel>

        <!-- Déconnexion en bas -->
        <Button DockPanel.Dock="Bottom"
                Content="⟵  Déconnexion"
                Style="{StaticResource GhostButton}"
                Command="{Binding LogoutCommand}"
                Margin="16,0,16,20"/>

        <!-- Navigation -->
        <StackPanel Margin="12,0">
          <Button Content="👥  Clients"
                  Style="{StaticResource GhostButton}"
                  Command="{Binding NavClientsCommand}"
                  HorizontalContentAlignment="Left"
                  Padding="12,10" Margin="0,2"/>
          <Button Content="📋  Contrats"
                  Style="{StaticResource GhostButton}"
                  Command="{Binding NavContratsCommand}"
                  HorizontalContentAlignment="Left"
                  Padding="12,10" Margin="0,2"/>
          <Button Content="💰  Tableau de Bord"
                  Style="{StaticResource GhostButton}"
                  Command="{Binding NavDashboardCommand}"
                  HorizontalContentAlignment="Left"
                  Padding="12,10" Margin="0,2"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ── Content Frame ──────────────────────────────────────────────── -->
    <Frame x:Name="ContentFrame"
           Grid.Column="1"
           NavigationUIVisibility="Hidden"
           Background="Transparent"/>

  </Grid>
</Window>
