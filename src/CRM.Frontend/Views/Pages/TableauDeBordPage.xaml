<Page x:Class="CRM.Frontend.Views.Pages.TableauDeBordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PrimaryBrush}"
      FontFamily="{StaticResource PrimaryFont}"
      Title="Tableau de Bord Financier">

  <Grid Margin="32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ── En-tête ──────────────────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
      <TextBlock Text="💰 Tableau de Bord Financier" FontSize="24" FontWeight="Bold"
                 Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- ── Barre de recherche ─────────────────────────────────────────── -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="No Client :" FontSize="14" Foreground="{StaticResource SubtextBrush}"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Style="{StaticResource InputBox}" Width="120"
                 Text="{Binding SearchNoClient, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Content="🔍 Afficher Solde" Style="{StaticResource BaseButton}"
                Command="{Binding LoadSoldeCommand}" Margin="10,0,0,0"/>
      </StackPanel>
    </Border>

    <!-- ── Message d'alerte ──────────────────────────────────────────── -->
    <Border Grid.Row="2" CornerRadius="6" Padding="12,8"
            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisible}}"
            Margin="0,0,0,12">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsError}" Value="True">
              <Setter Property="Background" Value="#3E1E1E"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsError}" Value="False">
              <Setter Property="Background" Value="#1A3326"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsError}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsError}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Border>

    <!-- ── Tableau soldes ──────────────────────────────────────────────── -->
    <Border Grid.Row="3" Style="{StaticResource Card}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid ItemsSource="{Binding Soldes}" SelectedItem="{Binding SelectedSolde}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Contrat"   Binding="{Binding NoContrat}"          Width="70"/>
            <DataGridTextColumn Header="Entreprise" Binding="{Binding NomEntreprise}"     Width="*"/>
            <DataGridTextColumn Header="Plafond"   Binding="{Binding MontantMax, StringFormat=C}"  Width="120"/>
            <DataGridTextColumn Header="Facturé"   Binding="{Binding TotalFactures, StringFormat=C}" Width="120"/>
            <DataGridTextColumn Header="Payé"      Binding="{Binding TotalPaiements, StringFormat=C}" Width="120"/>
            <DataGridTextColumn Header="Solde"     Binding="{Binding SoldeContrat, StringFormat=C}"  Width="120"/>
            <DataGridTextColumn Header="Crédit Dispo" Binding="{Binding CreditDisponible, StringFormat=C}" Width="130"/>
          </DataGrid.Columns>

          <!-- Coloration rouge si solde proche du plafond -->
          <DataGrid.RowStyle>
            <Style TargetType="DataGridRow">
              <Style.Triggers>
                <DataTrigger Binding="{Binding ContratActif}" Value="False">
                  <Setter Property="Opacity" Value="0.4"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
        </DataGrid>

        <!-- ── Panel paiement (DirecteurFinances seulement) ──────────── -->
        <Border Grid.Row="1"
                Background="#1E2435" CornerRadius="8" Padding="16,12"
                Margin="0,12,0,0"
                Visibility="{Binding IsDirecteurFinances, Converter={StaticResource BoolToVisible}}">
          <StackPanel>
            <TextBlock Text="🔑 Enregistrer un paiement" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Contrat #" FontSize="13" Foreground="{StaticResource SubtextBrush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBox Style="{StaticResource InputBox}" Width="80"
                       Text="{Binding PaiementNoContrat, UpdateSourceTrigger=PropertyChanged}"/>

              <TextBlock Text="Montant ($)" FontSize="13" Foreground="{StaticResource SubtextBrush}"
                         VerticalAlignment="Center" Margin="16,0,8,0"/>
              <TextBox Style="{StaticResource InputBox}" Width="120"
                       Text="{Binding PaiementMontant, UpdateSourceTrigger=PropertyChanged}"/>

              <TextBlock Text="Référence" FontSize="13" Foreground="{StaticResource SubtextBrush}"
                         VerticalAlignment="Center" Margin="16,0,8,0"/>
              <TextBox Style="{StaticResource InputBox}" Width="160"
                       Text="{Binding PaiementRef, UpdateSourceTrigger=PropertyChanged}"/>

              <Button Content="Enregistrer" Style="{StaticResource BaseButton}"
                      Command="{Binding EnregistrerPaiementCommand}" Margin="16,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

  </Grid>


</Page>
