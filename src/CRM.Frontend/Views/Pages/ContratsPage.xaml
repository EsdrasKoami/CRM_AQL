<Page x:Class="CRM.Frontend.Views.Pages.ContratsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PrimaryBrush}"
      FontFamily="{StaticResource PrimaryFont}"
      Title="Gestion des Contrats">

  <Grid Margin="32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ── En-tête ──────────────────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
      <TextBlock Text="📋 Gestion des Contrats" FontSize="24" FontWeight="Bold"
                 Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- ── Recherche par client ──────────────────────────────────────── -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="No Client :" FontSize="14" Foreground="{StaticResource SubtextBrush}"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBox Style="{StaticResource InputBox}" Width="120"
                 Text="{Binding SearchNoClient, UpdateSourceTrigger=PropertyChanged}"/>
        <Button Content="🔍 Rechercher" Style="{StaticResource BaseButton}"
                Command="{Binding SearchCommand}" Margin="10,0,0,0"/>
        <Button Content="+ Nouveau Contrat"
                Style="{StaticResource BaseButton}"
                Command="{Binding ShowFormCommand}"
                Visibility="{Binding CanCreate, Converter={StaticResource BoolToVisible}}"
                Margin="10,0,0,0"/>
      </StackPanel>
    </Border>

    <!-- ── Alerte erreur/succès ──────────────────────────────────────── -->
    <Border Grid.Row="2" CornerRadius="6" Padding="12,8"
            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisible}}"
            Margin="0,0,0,12">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsError}" Value="True">
              <Setter Property="Background" Value="#3E1E1E"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsError}" Value="False">
              <Setter Property="Background" Value="#1A3326"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsError}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsError}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Border>

    <!-- ── Tableau des contrats ──────────────────────────────────────── -->
    <Border Grid.Row="3" Style="{StaticResource Card}">
      <DataGrid ItemsSource="{Binding Contrats}" SelectedItem="{Binding Selected}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="No"         Binding="{Binding NoContrat}"              Width="50"/>
          <DataGridTextColumn Header="Client"     Binding="{Binding NoClient}"               Width="90"/>
          <DataGridTextColumn Header="Début"      Binding="{Binding DateDebut, StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>
          <DataGridTextColumn Header="Fin"        Binding="{Binding DateFin, StringFormat={}{0:yyyy-MM-dd}}"   Width="110"/>
          <DataGridTextColumn Header="Plafond ($)" Binding="{Binding MontantMax, StringFormat=C}"  Width="130"/>
          <DataGridTextColumn Header="Description" Binding="{Binding Description}"           Width="*"/>
          <DataGridCheckBoxColumn Header="Actif"  Binding="{Binding EstActif}"               Width="60"/>
        </DataGrid.Columns>

        <!-- Double-clic → vérifier ContratValid -->
        <DataGrid.InputBindings>
          <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding CheckValidCommand}"/>
        </DataGrid.InputBindings>
      </DataGrid>
    </Border>

  </Grid>


</Page>
