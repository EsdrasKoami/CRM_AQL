<Page x:Class="CRM.Frontend.Views.Pages.ClientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PrimaryBrush}"
      FontFamily="{StaticResource PrimaryFont}"
      Title="Gestion des Clients">

  <Grid Margin="32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ── En-tête ──────────────────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
      <TextBlock Text="👥 Gestion des Clients" FontSize="24" FontWeight="Bold"
                 Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
      <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="20,4"/>
      <Button Content="+ Nouveau Client"
              Style="{StaticResource BaseButton}"
              Command="{Binding ShowAddFormCommand}"
              Visibility="{Binding CanCreate, Converter={StaticResource BoolToVisible}}"
              VerticalAlignment="Center"/>
      <Button Content="🔄 Rafraîchir"
              Style="{StaticResource GhostButton}"
              Command="{Binding LoadCommand}"
              Margin="8,0,0,0" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- ── Formulaire d'ajout ────────────────────────────────────────── -->
    <Border Grid.Row="1" Style="{StaticResource Card}"
            Visibility="{Binding ShowForm, Converter={StaticResource BoolToVisible}}"
            Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="4" Text="Nouveau client" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
          <TextBlock Text="No Client (C######)" FontSize="12" Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,4"/>
          <TextBox Style="{StaticResource InputBox}" Text="{Binding NewClient.NoClient, UpdateSourceTrigger=PropertyChanged}" MaxLength="7"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
          <TextBlock Text="Nom de l'entreprise" FontSize="12" Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,4"/>
          <TextBox Style="{StaticResource InputBox}" Text="{Binding NewClient.NomEntreprise, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,0">
          <TextBlock Text="Courriel" FontSize="12" Foreground="{StaticResource SubtextBrush}" Margin="0,0,0,4"/>
          <TextBox Style="{StaticResource InputBox}" Text="{Binding NewClient.Courriel, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
          <Button Content="Enregistrer" Style="{StaticResource BaseButton}" Command="{Binding SaveClientCommand}" Margin="0,0,8,0"/>
          <Button Content="Annuler" Style="{StaticResource GhostButton}" Command="{Binding CancelFormCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ── Message d'erreur / succès ─────────────────────────────────── -->
    <Border Grid.Row="1" CornerRadius="6" Padding="12,8"
            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisible}}"
            Margin="0,0,0,12">
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsError}" Value="True">
              <Setter Property="Background" Value="#3E1E1E"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsError}" Value="False">
              <Setter Property="Background" Value="#1A3326"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextWrapping="Wrap">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsError}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsError}" Value="False">
                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Border>

    <!-- ── Tableau ────────────────────────────────────────────────────── -->
    <Border Grid.Row="2" Style="{StaticResource Card}">
      <DataGrid ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="No Client"   Binding="{Binding NoClient}"      Width="100"/>
          <DataGridTextColumn Header="Entreprise"  Binding="{Binding NomEntreprise}" Width="*"/>
          <DataGridTextColumn Header="Ville"       Binding="{Binding Ville}"         Width="120"/>
          <DataGridTextColumn Header="Courriel"    Binding="{Binding Courriel}"      Width="200"/>
          <DataGridCheckBoxColumn Header="Actif"   Binding="{Binding EstActif}"      Width="60"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </Grid>


</Page>
