## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (DotSettings)
*.csproj.DotSettings.user

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa]rm/
[Aa]rm64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
[Tt]est[Rr]esults/
[Pp]ublish/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you use Visual Studio Code
.vscode/

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet repositories to provide packages
# !/.nuget/packages.microsoft.xml

# Entity Framework Core migration report files
*.Design.TimeSeries.json

# BROWSER ASSETS
node_modules/

# DATABASE (SQLite)
*.db
*.db-shm
*.db-wal

# LOG FILES (CRM API)
src/CRM.Api/logs/*.log

# User-specific files
.env
.env.*

# Specialized folders
BenchmarkDotNet.Artifacts/